# Build output
/target/
**/target/

# Internal workspace artifacts (kept on disk, never committed)
/.drivers/
/.workbuddy-ai/
/spike/
/测试/
# 示例配置随仓库发布；bench 用的那组是本机环境，不提交
/examples/qsdb_bench/
/scripts/

# Internal development docs, reports, screenshots, logs
/*.md
!/README.md
/*.pdf
/*.html
/*.png
/*.jpg
/*.jpeg
/*.log

# Per-crate operational examples (environment-specific)
crates/**/examples/

# Local configuration and secrets
.env
.env.*
*.local.yaml
*.local.yml
.idea/
.vscode/
